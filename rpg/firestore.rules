rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: profiles
    // Document ID: {uid} (Firebase Auth UID)
    // Fields:
    //   - uid: string (matches document ID)
    //   - username: string (1..60 chars)
    //   - photoURL: string | null (optional, 0..120000 chars - external URL or compressed circular avatar Data URL)
    //   - avatar_data: string | null (optional, 0..120000 chars - compressed circular avatar Data URL)
    //   - role: string ('player' | 'master')
    //   - rank: string ('F'..'S')
    //   - level: int (1..100)
    //   - xp: int (>= 0)
    //   - gold: int (>= 0)
    //   - slots: int (1..200)
    //   - party_id: string | null (optional)
    //   - inventory: list (size <= 200)
    //   - equipment: map
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: users_private
    // Document ID: {uid} (Firebase Auth UID, isolated PII)
    // Fields:
    //   - uid: string (matches document ID)
    //   - email: string (<= 254 chars)
    //   - provider: string (<= 50 chars)
    //   - createdAt: timestamp (optional)
    //
    // Collection: parties
    // Document ID: {partyId} (auto-generated)
    // Fields:
    //   - name: string (1..80 chars)
    //   - leader_id: string | null (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: missions
    // Document ID: {missionId} (auto-generated)
    // Fields:
    //   - title: string (1..150 chars)
    //   - description: string (<= 3000 chars)
    //   - rank: string
    //   - xp_reward: int (>= 0)
    //   - gold_reward: int (>= 0)
    //   - status: string ('open' | 'in_progress' | 'completed' | 'failed')
    //   - assigned_to: string | null (optional)
    //   - assigned_to_name: string | null (optional)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: shop_items
    // Document ID: {itemId} (auto-generated)
    // Fields:
    //   - item_name: string (1..100 chars)
    //   - description: string (<= 3000 chars)
    //   - price: int (>= 1)
    //   - quantity: int (>= 0)
    //   - type: string
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: item_requests
    // Document ID: {requestId} (auto-generated)
    // Fields:
    //   - player_id: string (1..128 chars)
    //   - player_name: string (1..60 chars)
    //   - item_name: string (1..100 chars)
    //   - quantity: int (1..999)
    //   - status: string ('pending' | 'approved' | 'rejected' | 'cancelled')
    //   - createdAt: timestamp (optional)
    //   - resolvedAt: timestamp (optional)
    //
    // Collection: trade_requests
    // Document ID: {tradeId} (auto-generated)
    // Fields:
    //   - type: string ('gold' | 'item')
    //   - sender_id: string (1..128 chars)
    //   - sender_name: string (1..60 chars)
    //   - receiver_id: string (1..128 chars, != sender_id)
    //   - receiver_name: string (1..60 chars)
    //   - amount: int (optional, for gold trade)
    //   - item: map (optional, for item trade)
    //   - status: string ('pending' | 'accepted' | 'rejected' | 'cancelled' | 'refunded')
    //   - createdAt: timestamp (optional)
    //   - resolvedAt: timestamp (optional)
    //
    // Collection: maps
    // Document ID: {mapId} (auto-generated)
    // Fields:
    //   - title: string (1..150 chars)
    //   - imageUrl: string (<= 950000 chars)
    //   - naturalWidth: number (optional, 1..32768)
    //   - naturalHeight: number (optional, 1..32768)
    //   - hd_chunk_count: int (optional, 0..32 - number of HD image chunks in subcollection)
    //   - hd_mime_type: string | null (optional, 0..64 chars - MIME type for HD chunk reassembly)
    //   - gridType: string ('square' | 'hex' | 'none')
    //   - gridSize: number (10..300)
    //   - autoGrid: bool (optional)
    //   - gridOpacity: number (0..1)
    //   - scale: number (0.1..5.0)
    //   - is_active: bool
    //   - is_locked: bool
    //   - fog_enabled: bool (optional)
    //   - combat_active: bool (optional)
    //   - current_turn_token_id: string | null (optional, 0..128 chars)
    //   - effects: map | null (optional, size <= 30 - atmosphere overlays: weather, fog, darkness, blackout, torchRadius)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Subcollection: maps/{mapId}/image_chunks
    // Document ID: {chunkId} (chunk index string, e.g. '0', '1', ...)
    // Fields:
    //   - map_id: string (1..128 chars, matches parent {mapId})
    //   - index: int (0..32)
    //   - data: string (1..850000 chars - base64 HD image chunk payload)
    //   - createdAt: timestamp (optional)
    //
    // Collection: map_tokens
    // Document ID: {tokenId} (auto-generated)
    // Fields:
    //   - map_id: string (1..128 chars)
    //   - name: string (1..100 chars)
    //   - type: string ('player' | 'npc' | 'monster')
    //   - character_id: string | null (optional, 0..128 chars)
    //   - owner_id: string | null (optional, 0..128 chars)
    //   - color: string | null (optional, 0..50 chars)
    //   - avatar: string | null (optional, 0..100000 chars)
    //   - x: number (0..100)
    //   - y: number (0..100)
    //   - size: string ('S' | 'M' | 'L' | 'H' | 'G')
    //   - hp: int (>= 0)
    //   - max_hp: int (>= 1)
    //   - ac: int (>= 0)
    //   - mana: int (optional, >= 0)
    //   - max_mana: int (optional, >= 0)
    //   - conditions: list (optional, size <= 20)
    //   - initiative: number (optional)
    //   - hidden: bool (optional)
    //   - is_ally: bool (optional - marks monster/NPC as ally so players can see its HP bar)
    //   - name_hidden: bool (optional - hides monster/NPC name from players until revealed)
    //   - monster_id: string | null (optional, 0..128 chars - Monster Manual bestiary reference)
    //   - sync_group_id: string | null (optional, 0..128 chars - links identical entities across maps for synchronized HP/vitals)
    //   - light_radius: number | null (optional, 0..85 - per-token light radius, or null/omitted to inherit map global torch setting)
    //   - light_color: string | null (optional, 0..32 chars - per-token light tint e.g. 'warm', 'arcane', 'holy', 'emerald', 'crimson', or null/omitted)
    //   - createdAt: timestamp (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: map_pings
    // Document ID: {pingId} (auto-generated)
    // Fields:
    //   - map_id: string (1..128 chars)
    //   - user_id: string (1..128 chars)
    //   - user_name: string | null (optional, 0..60 chars)
    //   - x: number (0..100)
    //   - y: number (0..100)
    //   - color: string | null (optional, 0..50 chars)
    //   - createdAt: timestamp (optional)
    //
    // Collection: map_rolls
    // Document ID: {rollId} (auto-generated)
    // Fields:
    //   - map_id: string (1..128 chars)
    //   - user_id: string (1..128 chars)
    //   - user_name: string | null (optional, 0..60 chars)
    //   - user_role: string | null (optional, 0..30 chars)
    //   - sides: int (2..1000)
    //   - count: int (optional, 1..20 - number of dice rolled)
    //   - results: list (optional, size <= 20 - individual die results)
    //   - roll: int (1..20000)
    //   - total: int (optional, 1..20000 - sum of multi-dice roll)
    //   - formula: string | null (optional, 0..30 chars, e.g. 'd20', '3d6')
    //   - max_hits: int (optional, 0..20)
    //   - fumble_hits: int (optional, 0..20)
    //   - all_max: bool (optional)
    //   - seed: number | string (optional)
    //   - is_max: bool (optional)
    //   - is_fumble: bool (optional)
    //   - createdAt: timestamp (optional)
    //
    // Collection: character_sheets
    // Document ID: {uid} (Firebase Auth UID of the hero)
    // Fields:
    //   - uid: string (1..128 chars, matches document ID, immutable)
    //   - fields: map (size <= 500, dynamic Ficha.pdf form field key-value entries)
    //   - updatedBy: string | null (optional, 0..128 chars)
    //   - updatedByName: string | null (optional, 0..60 chars)
    //   - updatedByRole: string | null (optional, 'player' | 'master')
    //   - createdAt: timestamp (optional, immutable once set)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: table_audio
    // Document ID: {sessionId} (e.g. 'main' - synchronized tabletop music player state)
    // Fields:
    //   - playlist: list (optional, size <= 100 - ordered track metadata entries)
    //   - currentTrackId: string | null (optional, 0..128 chars)
    //   - currentIndex: int | null (optional, -1..100)
    //   - isPlaying: bool | null (optional)
    //   - basePositionSec: number | null (optional, 0..86400)
    //   - anchorClientMs: number | null (optional, 0..9999999999999)
    //   - loopMode: string | null (optional, 'playlist' | 'one' | 'off')
    //   - shuffle: bool | null (optional)
    //   - syncVersion: int | null (optional, 0..100000000)
    //   - lastSfx: map | null (optional, size <= 20 - synchronized soundboard trigger payload)
    //   - updatedBy: string | null (optional, 0..128 chars)
    //   - updatedByName: string | null (optional, 0..60 chars)
    //   - serverUpdatedAt: timestamp | null (optional)
    //   - updatedAt: timestamp | null (optional)
    //
    // Subcollection: table_audio/{sessionId}/audio_chunks
    // Document ID: {chunkId} (chunk identifier, e.g. '{trackId}_{index}')
    // Fields:
    //   - track_id: string (required, 1..128 chars)
    //   - index: int (required, 0..32)
    //   - data: string (required, 1..850000 chars - base64 audio chunk payload)
    //   - createdAt: timestamp | null (optional)
    //
    // Collection: table_handouts
    // Document ID: {handoutId} (auto-generated - synchronized table handouts/letters/clues)
    // Fields:
    //   - title: string (required, 1..150 chars)
    //   - subtitle: string | null (optional, 0..120 chars)
    //   - content: string | null (optional, 0..8000 chars)
    //   - imageUrl: string | null (optional, 0..850000 chars)
    //   - style: string | null (optional, 'parchment' | 'image' | 'combined')
    //   - is_active: bool | null (optional)
    //   - visible_to: list | null (optional, size <= 60)
    //   - created_by: string | null (optional, 0..128 chars)
    //   - shownAt: timestamp | null (optional)
    //   - createdAt: timestamp | null (optional)
    //   - updatedAt: timestamp | null (optional)
    //
    // Collection: table_whispers
    // Document ID: {whisperId} (auto-generated - strict private Master-to-Player whispers)
    // Fields:
    //   - target_uid: string (required, 1..128 chars, immutable for recipient)
    //   - target_name: string | null (optional, 0..60 chars, immutable for recipient)
    //   - sender_uid: string | null (optional, 0..128 chars, immutable for recipient)
    //   - sender_name: string | null (optional, 0..60 chars, immutable for recipient)
    //   - message: string (required, 1..2000 chars, immutable for recipient)
    //   - category: string | null (optional, 'secret' | 'perception' | 'lore' | 'warning', immutable for recipient)
    //   - read: bool | null (optional, mutable by recipient)
    //   - createdAt: timestamp | null (optional, immutable for recipient)
    //   - readAt: timestamp | null (optional, mutable by recipient)
    //   - updatedAt: timestamp | null (optional)
    //
    // Collection: loot_chests
    // Document ID: {chestId} (auto-generated - shared post-combat loot chests with selective visibility)
    // Fields:
    //   - title: string (required, 1..120 chars, immutable for players)
    //   - theme: string | null (optional, 0..120 chars, immutable for players)
    //   - status: string (required, 'open' | 'closed', immutable for players)
    //   - gold: int (required, 0..2000000000, non-increasing for players)
    //   - visible_to: list (required, size <= 60, immutable for players; 'all' or player UIDs)
    //   - items: list (required, size <= 40, size non-increasing for players)
    //   - logs: list | null (optional, size <= 80)
    //   - created_by: string | null (optional, 0..128 chars, immutable for players)
    //   - createdAt: timestamp | null (optional, immutable for players)
    //   - updatedAt: timestamp | null (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the user is a Master (Admin).
    // Derives authority from Auth custom claims or the stored profiles/{uid} doc.
    function isMaster() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'master') ||
        (
          exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('role', 'player') == 'master'
        )
      );
    }

    function isSafeString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isSafeOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    function isSafeInt(val, minVal, maxVal) {
      return val is int && val >= minVal && val <= maxVal;
    }

    function isSafeOptionalInt(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null ||
        (data[field] is int && data[field] >= minVal && data[field] <= maxVal);
    }

    function isSafeNumber(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isSafeOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null ||
        ((data[field] is int || data[field] is float) && data[field] >= minVal && data[field] <= maxVal);
    }

    function isSafeOptionalBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function isSafeOptionalList(data, field, maxSize) {
      return !(field in data) || data[field] == null ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function isSafeOptionalMap(data, field, maxSize) {
      return !(field in data) || data[field] == null ||
        (data[field] is map && data[field].size() <= maxSize);
    }

    function isSafeOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    // ===============================================================
    // Domain Validator Functions (Used on creates and updates)
    // ===============================================================

    function isValidProfile(data, uid) {
      return data.uid is string && data.uid == uid &&
        isSafeString(data.username, 1, 60) &&
        data.role in ['player', 'master'] &&
        data.rank is string &&
        isSafeInt(data.level, 1, 100) &&
        isSafeInt(data.xp, 0, 2000000000) &&
        isSafeInt(data.gold, 0, 2000000000) &&
        isSafeInt(data.slots, 1, 200) &&
        data.inventory is list && data.inventory.size() <= 200 &&
        data.equipment is map &&
        isSafeOptionalString(data, 'photoURL', 0, 120000) &&
        isSafeOptionalString(data, 'avatar_data', 0, 120000) &&
        isSafeOptionalString(data, 'party_id', 0, 128) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidUsersPrivate(data, uid) {
      return data.uid is string && data.uid == uid &&
        data.email is string && data.email.size() <= 254 &&
        data.provider is string && data.provider.size() <= 50 &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidParty(data) {
      return isSafeString(data.name, 1, 80) &&
        isSafeOptionalString(data, 'leader_id', 0, 128) &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidMission(data) {
      return isSafeString(data.title, 1, 150) &&
        data.description is string && data.description.size() <= 3000 &&
        data.rank is string &&
        isSafeInt(data.xp_reward, 0, 100000000) &&
        isSafeInt(data.gold_reward, 0, 100000000) &&
        data.status in ['open', 'in_progress', 'completed', 'failed'] &&
        isSafeOptionalString(data, 'assigned_to', 0, 128) &&
        isSafeOptionalString(data, 'assigned_to_name', 0, 60) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidShopItem(data) {
      return isSafeString(data.item_name, 1, 100) &&
        data.description is string && data.description.size() <= 3000 &&
        isSafeInt(data.price, 1, 2000000000) &&
        isSafeInt(data.quantity, 0, 10000000) &&
        data.type is string &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidItemRequest(data) {
      return isSafeString(data.player_id, 1, 128) &&
        isSafeString(data.player_name, 1, 60) &&
        isSafeString(data.item_name, 1, 100) &&
        isSafeInt(data.quantity, 1, 999) &&
        data.status in ['pending', 'approved', 'rejected', 'cancelled'] &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'resolvedAt');
    }

    function isValidTradeRequest(data) {
      return data.type in ['gold', 'item'] &&
        isSafeString(data.sender_id, 1, 128) &&
        isSafeString(data.sender_name, 1, 60) &&
        isSafeString(data.receiver_id, 1, 128) &&
        data.receiver_id != data.sender_id &&
        isSafeString(data.receiver_name, 1, 60) &&
        data.status in ['pending', 'accepted', 'rejected', 'cancelled', 'refunded'] &&
        isSafeOptionalInt(data, 'amount', 1, 2000000000) &&
        (!('item' in data) || data.item is map) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'resolvedAt');
    }

    function isValidMap(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.imageUrl is string && data.imageUrl.size() <= 950000 &&
        data.is_active is bool &&
        data.is_locked is bool &&
        (!('gridType' in data) || data.gridType in ['square', 'hex', 'none']) &&
        (!('gridSize' in data) || data.gridSize is int || data.gridSize is float) &&
        (!('gridOpacity' in data) || data.gridOpacity is int || data.gridOpacity is float) &&
        (!('scale' in data) || data.scale is int || data.scale is float) &&
        isSafeOptionalNumber(data, 'naturalWidth', 1, 32768) &&
        isSafeOptionalNumber(data, 'naturalHeight', 1, 32768) &&
        isSafeOptionalInt(data, 'hd_chunk_count', 0, 32) &&
        isSafeOptionalString(data, 'hd_mime_type', 0, 64) &&
        isSafeOptionalBool(data, 'autoGrid') &&
        isSafeOptionalBool(data, 'fog_enabled') &&
        isSafeOptionalBool(data, 'combat_active') &&
        isSafeOptionalString(data, 'current_turn_token_id', 0, 128) &&
        isSafeOptionalMap(data, 'effects', 30) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidMapImageChunk(data) {
      return 'map_id' in data && isSafeString(data.map_id, 1, 128) &&
        'index' in data && isSafeInt(data.index, 0, 32) &&
        'data' in data && isSafeString(data.data, 1, 850000) &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidMapToken(data) {
      return data.map_id is string && data.map_id.size() >= 1 && data.map_id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.type in ['player', 'npc', 'monster'] &&
        data.size in ['S', 'M', 'L', 'H', 'G'] &&
        data.hp is int &&
        data.max_hp is int &&
        data.ac is int &&
        (!('x' in data) || data.x is int || data.x is float) &&
        (!('y' in data) || data.y is int || data.y is float) &&
        isSafeOptionalString(data, 'character_id', 0, 128) &&
        isSafeOptionalString(data, 'owner_id', 0, 128) &&
        isSafeOptionalString(data, 'color', 0, 50) &&
        isSafeOptionalString(data, 'avatar', 0, 100000) &&
        isSafeOptionalInt(data, 'mana', 0, 100000) &&
        isSafeOptionalInt(data, 'max_mana', 0, 100000) &&
        isSafeOptionalList(data, 'conditions', 20) &&
        (!('initiative' in data) || data.initiative == null || data.initiative is int || data.initiative is float) &&
        isSafeOptionalBool(data, 'hidden') &&
        isSafeOptionalBool(data, 'is_ally') &&
        isSafeOptionalBool(data, 'name_hidden') &&
        isSafeOptionalString(data, 'monster_id', 0, 128) &&
        isSafeOptionalString(data, 'sync_group_id', 0, 128) &&
        isSafeOptionalNumber(data, 'light_radius', 0, 85) &&
        isSafeOptionalString(data, 'light_color', 0, 32) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidMapPing(data) {
      return data.map_id is string && data.map_id.size() >= 1 && data.map_id.size() <= 128 &&
        data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
        (!('x' in data) || data.x is int || data.x is float) &&
        (!('y' in data) || data.y is int || data.y is float) &&
        isSafeOptionalString(data, 'user_name', 0, 60) &&
        isSafeOptionalString(data, 'color', 0, 50) &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidMapRoll(data) {
      return data.map_id is string && data.map_id.size() >= 1 && data.map_id.size() <= 128 &&
        data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
        isSafeOptionalString(data, 'user_name', 0, 60) &&
        isSafeOptionalString(data, 'user_role', 0, 30) &&
        (!('sides' in data) || data.sides is int) &&
        (!('roll' in data) || data.roll is int) &&
        isSafeOptionalInt(data, 'count', 1, 20) &&
        isSafeOptionalList(data, 'results', 20) &&
        isSafeOptionalInt(data, 'total', 1, 20000) &&
        isSafeOptionalString(data, 'formula', 0, 30) &&
        isSafeOptionalInt(data, 'max_hits', 0, 20) &&
        isSafeOptionalInt(data, 'fumble_hits', 0, 20) &&
        isSafeOptionalBool(data, 'all_max') &&
        (!('seed' in data) || data.seed == null || data.seed is int || data.seed is float || data.seed is string) &&
        isSafeOptionalBool(data, 'is_max') &&
        isSafeOptionalBool(data, 'is_fumble') &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidCharacterSheet(data, uid) {
      return 'uid' in data && isSafeString(data.uid, 1, 128) && data.uid == uid &&
        'fields' in data && data.fields is map && data.fields.size() <= 500 &&
        isSafeOptionalString(data, 'updatedBy', 0, 128) &&
        isSafeOptionalString(data, 'updatedByName', 0, 60) &&
        (!('updatedByRole' in data) || data.updatedByRole == null || data.updatedByRole in ['player', 'master']) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTableAudio(data) {
      return (!('playlist' in data) || (data.playlist is list && data.playlist.size() <= 100)) &&
        isSafeOptionalString(data, 'currentTrackId', 0, 128) &&
        isSafeOptionalInt(data, 'currentIndex', -1, 100) &&
        isSafeOptionalBool(data, 'isPlaying') &&
        isSafeOptionalNumber(data, 'basePositionSec', 0, 86400) &&
        isSafeOptionalNumber(data, 'anchorClientMs', 0, 9999999999999) &&
        (!('loopMode' in data) || data.loopMode == null || data.loopMode in ['playlist', 'one', 'off']) &&
        isSafeOptionalBool(data, 'shuffle') &&
        isSafeOptionalInt(data, 'syncVersion', 0, 100000000) &&
        isSafeOptionalMap(data, 'lastSfx', 20) &&
        isSafeOptionalString(data, 'updatedBy', 0, 128) &&
        isSafeOptionalString(data, 'updatedByName', 0, 60) &&
        isSafeOptionalTimestamp(data, 'serverUpdatedAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidAudioChunk(data) {
      return 'track_id' in data && data.track_id is string && data.track_id.size() >= 1 && data.track_id.size() <= 128 &&
        'index' in data && data.index is int && data.index >= 0 && data.index <= 32 &&
        'data' in data && data.data is string && data.data.size() >= 1 && data.data.size() <= 850000 &&
        isSafeOptionalTimestamp(data, 'createdAt');
    }

    function isValidTableHandout(data) {
      return 'title' in data && isSafeString(data.title, 1, 150) &&
        isSafeOptionalString(data, 'subtitle', 0, 120) &&
        isSafeOptionalString(data, 'content', 0, 8000) &&
        isSafeOptionalString(data, 'imageUrl', 0, 850000) &&
        (!('style' in data) || data.style == null || data.style in ['parchment', 'image', 'combined']) &&
        isSafeOptionalBool(data, 'is_active') &&
        isSafeOptionalList(data, 'visible_to', 60) &&
        isSafeOptionalString(data, 'created_by', 0, 128) &&
        isSafeOptionalTimestamp(data, 'shownAt') &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTableWhisper(data) {
      return 'target_uid' in data && isSafeString(data.target_uid, 1, 128) &&
        isSafeOptionalString(data, 'target_name', 0, 60) &&
        isSafeOptionalString(data, 'sender_uid', 0, 128) &&
        isSafeOptionalString(data, 'sender_name', 0, 60) &&
        'message' in data && isSafeString(data.message, 1, 2000) &&
        (!('category' in data) || data.category == null || data.category in ['secret', 'perception', 'lore', 'warning']) &&
        isSafeOptionalBool(data, 'read') &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'readAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    function isValidLootChest(data) {
      return 'title' in data && isSafeString(data.title, 1, 120) &&
        isSafeOptionalString(data, 'theme', 0, 120) &&
        'status' in data && data.status in ['open', 'closed'] &&
        'gold' in data && isSafeInt(data.gold, 0, 2000000000) &&
        'visible_to' in data && data.visible_to is list && data.visible_to.size() <= 60 &&
        'items' in data && data.items is list && data.items.size() <= 40 &&
        isSafeOptionalList(data, 'logs', 80) &&
        isSafeOptionalString(data, 'created_by', 0, 128) &&
        isSafeOptionalTimestamp(data, 'createdAt') &&
        isSafeOptionalTimestamp(data, 'updatedAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public game profile (gold, xp, level, inventory, equipment, etc.)
    match /profiles/{uid} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        isValidProfile(request.resource.data, uid) &&
        (
          isMaster() ||
          (
            isOwner(uid) &&
            request.resource.data.role == 'player'
          )
        );

      allow update: if isAuthenticated() &&
        isValidProfile(request.resource.data, uid) &&
        (
          isMaster() ||
          (
            isOwner(uid) &&
            request.resource.data.uid == resource.data.uid &&
            (!('role' in resource.data) || request.resource.data.role == resource.data.role)
          )
        );

      allow delete: if isMaster();
    }

    // Strictly isolated private user data (email, auth provider)
    match /users_private/{uid} {
      allow read: if isOwner(uid) || isMaster();

      allow create, update: if (isOwner(uid) || isMaster()) &&
        isValidUsersPrivate(request.resource.data, uid);

      allow delete: if isMaster();
    }

    // Guilds and Adventurer Parties
    match /parties/{partyId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        isValidParty(request.resource.data);

      allow update: if isAuthenticated() &&
        isValidParty(request.resource.data) &&
        (
          isMaster() ||
          resource.data.leader_id == request.auth.uid ||
          resource.data.leader_id == null ||
          request.resource.data.leader_id == request.auth.uid
        );

      allow delete: if isAuthenticated() &&
        (isMaster() || resource.data.leader_id == request.auth.uid);
    }

    // Mission Board
    match /missions/{missionId} {
      allow read: if isAuthenticated();

      allow create, delete: if isMaster();

      allow update: if isAuthenticated() &&
        isValidMission(request.resource.data) &&
        (
          isMaster() ||
          (
            // Player accepts an open contract
            resource.data.status == 'open' &&
            request.resource.data.status == 'in_progress' &&
            request.resource.data.assigned_to == request.auth.uid &&
            request.resource.data.title == resource.data.title &&
            request.resource.data.xp_reward == resource.data.xp_reward &&
            request.resource.data.gold_reward == resource.data.gold_reward
          ) ||
          (
            // Assigned player updates their mission progress / completion / abandon
            resource.data.assigned_to == request.auth.uid &&
            request.resource.data.assigned_to == request.auth.uid &&
            request.resource.data.title == resource.data.title &&
            request.resource.data.xp_reward == resource.data.xp_reward &&
            request.resource.data.gold_reward == resource.data.gold_reward
          )
        );
    }

    // Shop Catalog
    match /shop_items/{itemId} {
      allow read: if isAuthenticated();

      allow create, delete: if isMaster();

      allow update: if isAuthenticated() &&
        isValidShopItem(request.resource.data) &&
        (
          isMaster() ||
          (
            // Player purchase: decrements available stock, keeps catalog attributes unchanged
            request.resource.data.quantity < resource.data.quantity &&
            request.resource.data.price == resource.data.price &&
            request.resource.data.item_name == resource.data.item_name
          )
        );
    }

    // Custom Item & Gacha Gift Requests
    match /item_requests/{requestId} {
      allow read: if isAuthenticated() &&
        (isMaster() || resource.data.player_id == request.auth.uid);

      allow create: if isAuthenticated() &&
        isValidItemRequest(request.resource.data) &&
        (
          isMaster() ||
          (
            request.resource.data.player_id == request.auth.uid &&
            request.resource.data.status == 'pending'
          )
        );

      allow update: if isAuthenticated() &&
        isValidItemRequest(request.resource.data) &&
        (
          isMaster() ||
          (
            // Player cancels their own pending request
            resource.data.player_id == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if isMaster();
    }

    // Player-to-Player Escrow Transfers
    match /trade_requests/{tradeId} {
      allow read: if isAuthenticated() &&
        (
          isMaster() ||
          resource.data.sender_id == request.auth.uid ||
          resource.data.receiver_id == request.auth.uid
        );

      allow create: if isAuthenticated() &&
        isValidTradeRequest(request.resource.data) &&
        (
          isMaster() ||
          (
            request.resource.data.sender_id == request.auth.uid &&
            request.resource.data.status == 'pending'
          )
        );

      allow update: if isAuthenticated() &&
        isValidTradeRequest(request.resource.data) &&
        (
          isMaster() ||
          // Receiver can accept or reject pending trades
          (
            resource.data.receiver_id == request.auth.uid &&
            resource.data.status == 'pending' &&
            request.resource.data.status in ['accepted', 'rejected']
          ) ||
          // Sender can cancel pending trade or refund rejected trade
          (
            resource.data.sender_id == request.auth.uid &&
            (
              (resource.data.status == 'pending' && request.resource.data.status == 'cancelled') ||
              (resource.data.status == 'rejected' && request.resource.data.status == 'refunded')
            )
          )
        );

      allow delete: if isMaster();
    }

    // Tactical Battlemaps (VTT)
    match /maps/{mapId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated() && isValidMap(request.resource.data);

      allow delete: if isAuthenticated();

      // HD Map Image Chunks (> 1 MiB original-resolution maps stored in ~720KB chunks)
      match /image_chunks/{chunkId} {
        allow read: if isAuthenticated();

        allow create, update: if isAuthenticated() &&
          isValidMapImageChunk(request.resource.data) &&
          request.resource.data.map_id == mapId;

        allow delete: if isAuthenticated();
      }
    }

    // Map Tokens (Heroes, Monsters, NPCs)
    match /map_tokens/{tokenId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated() && isValidMapToken(request.resource.data);

      allow delete: if isAuthenticated();
    }

    // Interactive Map Pings (Player/Master real-time markers)
    match /map_pings/{pingId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Real-time Tactical 3D Map Dice Rolls (Player/Master rolls)
    match /map_rolls/{rollId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    // Editable D&D 2024 Character Sheets (Ficha.pdf real-time sync between Hero and Master)
    match /character_sheets/{uid} {
      allow read: if isOwner(uid) || isMaster();

      allow create: if (isOwner(uid) || isMaster()) &&
        isValidCharacterSheet(request.resource.data, uid) &&
        (
          isMaster() ||
          (
            (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == null || request.resource.data.updatedBy == '' || request.resource.data.updatedBy == request.auth.uid) &&
            (!('updatedByRole' in request.resource.data) || request.resource.data.updatedByRole == null || request.resource.data.updatedByRole == 'player')
          )
        );

      allow update: if (isOwner(uid) || isMaster()) &&
        isValidCharacterSheet(request.resource.data, uid) &&
        request.resource.data.uid == resource.data.uid &&
        (
          !('createdAt' in resource.data) ||
          resource.data.createdAt == null ||
          ('createdAt' in request.resource.data && request.resource.data.createdAt == resource.data.createdAt)
        ) &&
        (
          isMaster() ||
          (
            (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == null || request.resource.data.updatedBy == '' || request.resource.data.updatedBy == request.auth.uid || ('updatedBy' in resource.data && request.resource.data.updatedBy == resource.data.updatedBy)) &&
            (!('updatedByRole' in request.resource.data) || request.resource.data.updatedByRole == null || request.resource.data.updatedByRole == 'player' || ('updatedByRole' in resource.data && request.resource.data.updatedByRole == resource.data.updatedByRole))
          )
        );

      allow delete: if isMaster();
    }

    // Synchronized Tabletop Music Player State & Chunked Audio Uploads
    match /table_audio/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isMaster() && isValidTableAudio(request.resource.data);
      allow delete: if isMaster();

      match /audio_chunks/{chunkId} {
        allow read: if isAuthenticated();
        allow create, update: if isMaster() && isValidAudioChunk(request.resource.data);
        allow delete: if isMaster();
      }
    }

    // Synchronized Table Handouts (Letters, Clues, Visual Props shown by Master)
    match /table_handouts/{handoutId} {
      allow read: if isAuthenticated();

      allow create, update: if isMaster() && isValidTableHandout(request.resource.data);

      allow delete: if isMaster();
    }

    // Strict Private Master-to-Player Whispers
    match /table_whispers/{whisperId} {
      allow read: if isMaster() ||
        (isAuthenticated() && resource.data.target_uid == request.auth.uid);

      allow create: if isMaster() && isValidTableWhisper(request.resource.data);

      allow update: if isAuthenticated() &&
        isValidTableWhisper(request.resource.data) &&
        (
          isMaster() ||
          (
            resource.data.target_uid == request.auth.uid &&
            request.resource.data.target_uid == resource.data.target_uid &&
            request.resource.data.message == resource.data.message &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
          )
        );

      allow delete: if isMaster();
    }

    // Shared Post-Combat Loot Chests (Selective Visibility)
    match /loot_chests/{chestId} {
      allow read: if isMaster() ||
        (
          isAuthenticated() &&
          ('all' in resource.data.visible_to || request.auth.uid in resource.data.visible_to)
        );

      allow create: if isMaster() && isValidLootChest(request.resource.data);

      allow update: if isAuthenticated() &&
        isValidLootChest(request.resource.data) &&
        (
          isMaster() ||
          (
            resource.data.status == 'open' &&
            ('all' in resource.data.visible_to || request.auth.uid in resource.data.visible_to) &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.visible_to == resource.data.visible_to &&
            request.resource.data.gold <= resource.data.gold &&
            request.resource.data.items.size() <= resource.data.items.size() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gold', 'items', 'logs', 'updatedAt'])
          )
        );

      allow delete: if isMaster();
    }

    // Default deny catch-all for any unmatched paths or collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
